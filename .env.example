# Resend (Emails)
RESEND_API_KEY=""
EMAIL_FROM="Karyana Bakery <orders@karyanabakery.ca>"
OWNER_EMAIL="karyana@karyanabakery.ca"

# Twilio (WhatsApp + SMS on order status changes)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Sender for WhatsApp, e.g. "+15873836789" (no "whatsapp:" prefix — the code
# adds it). Leave empty and every notification simply goes out as SMS.
TWILIO_WHATSAPP_FROM=""

# Messaging Service SID (MGxxxxxxxx). Twilio only accepts scheduled sends
# through a Messaging Service, so without it the ready/completed messages
# can't be handed over at checkout and the cron sends them instead — same
# messages, just up to 15 minutes off.
TWILIO_MESSAGING_SERVICE_SID=""

# Any long random string. Signs the delivery-report URL Twilio calls back, so
# a failed WhatsApp can be retried as SMS. Without it that callback is turned
# off (the endpoint would otherwise be an open SMS relay at our expense) and a
# WhatsApp that fails after Twilio accepted it never falls back.
TWILIO_STATUS_CALLBACK_SECRET=""

# Approved WhatsApp template SIDs (HXxxxxxxxx). Only needed for the scheduled
# messages: outside the 24h customer-service window WhatsApp requires a
# template, so without these the scheduled ones go out as SMS.
TWILIO_CONTENT_SID_READY=""
TWILIO_CONTENT_SID_COMPLETED=""

# How far ahead an order may be scheduled with Twilio. Anything further out is
# left to the cron. Optional, defaults to 7.
TWILIO_MAX_SCHEDULE_DAYS="7"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

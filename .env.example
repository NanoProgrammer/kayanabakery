# Karyana Bakery — environment variables
#
# Everything below EXCEPT the last section goes in Vercel:
#   Settings → Environment Variables → Production (and Preview).
# Copy this file to .env.local for local work.
#
# NEXT_PUBLIC_* are compiled into the browser bundle, so they are public by
# definition. Never put a secret behind that prefix.

# ─── Required: the site will not work without these ────────────────────────

# Postgres (Neon). The app and `npm run db:push` both use this one.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Signs sessions AND the password-reset links. Changing it signs everyone out
# and invalidates any reset link already sent. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# The canonical site URL, with no trailing slash. Must be the .ca — the .com
# redirects to it, and a redirect across origins drops the Authorization
# header, which is how the cron jobs once silently did nothing.
NEXT_PUBLIC_APP_URL="https://www.karyanabakery.ca"

# Sanity Studio — the Orders list the bakery actually works from.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-10-01"
# Needs Editor permission: this token writes orders, not just reads them.
SANITY_API_READ_TOKEN=
# Must match the secret on each webhook in Sanity's API settings.
SANITY_WEBHOOK_SECRET=

# Square — payments and memberships.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT="production"
NEXT_PUBLIC_SQUARE_APP_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=

# Email. Everything transactional goes through Resend.
RESEND_API_KEY=

# Shared with GitHub Actions. The crons answer 401 without it, which reads
# like the site is broken; it is a separate store from Vercel's.
CRON_SECRET=

# Google sign-in. Customers who created their account with the Google button
# have no password at all, so without these they cannot get in by any route.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Per feature: that feature is off without them ─────────────────────────

# Who email comes from and goes to.
FROM_EMAIL="Karyana Bakery <hola@karyanabakery.ca>"
ORDERS_EMAIL=
OWNER_EMAIL=
RESEND_AUDIENCE_ID=

# Order texts (WhatsApp first, SMS as a fallback).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_STATUS_CALLBACK_SECRET=

# Membership plans and the Square webhook.
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_PLAN_ARTESANO_VARIATION_ID=
SQUARE_PLAN_SELECTO_VARIATION_ID=
SQUARE_PLAN_LEGENDARIO_VARIATION_ID=

# Brevo lists (marketing only — transactional email is Resend).
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_EN_LIST_ID=
BREVO_ES_LIST_ID=
BREVO_MEMBERS_LIST_ID=
BREVO_PROGRAMS_PROMO_LIST_ID=
BREVO_TOGGLE_ON_LIST_ID=
BREVO_TOGGLE_OFF_LIST_ID=

# Delivery slots on Google Calendar. Two modules read the private key under
# two different names — set both to the same value until they are merged.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# The kitchen printer agent.
PRINTER_TOKEN=
# The day the printer went live. Without it the queue falls back to a week,
# and setting it too early prints every ticket since the bakery opened.
PRINT_SINCE="2026-10-01"

# Where the "leave us a review" link points.
GOOGLE_REVIEW_URL="https://www.google.com/maps?cid=2846011783105315821"

# ─── Local only — do NOT add these to Vercel ───────────────────────────────

# Points db:verify and db:push at the live database for one command, without
# editing .env.local and leaving everyday local work aimed at production.
# PROD_DATABASE_URL=

# Override the site the health and weekly test scripts talk to.
# HEALTH_SITE=
# WEEKLY_TEST_SITE=
